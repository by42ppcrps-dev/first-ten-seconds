{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-ten-seconds",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "Budget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }],
  "vars": { "AI_DISABLED": "0" },
  "observability": { "enabled": false }
}
